# ── 爆款研究所 · 环境变量 ─────────────────────────────────────────────
# 复制为 .env.local 后填值。所有 Key 仅服务端使用，切勿暴露到前端。
# 不填任何 Key 也能跑（全走 mock / 本地模板 / 启发式），只是没有真模型能力。

# ── 账号体系（必填，否则注册/登录会返回 503）────────────────────────
# Postgres 连接串。推荐 Neon（neon.tech）免费档，格式：
#   postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# 会话 JWT 签名密钥。生成一个随机长串，别用弱口令：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ⚠️ 改这个值会让所有已登录用户被登出。
JWT_SECRET=

# 种子数据导入口令（保护 /api/seed，不设置则该接口直接拒绝执行）
#   上线后执行一次：curl "https://你的域名/api/seed?token=<这里的值>"
SEED_TOKEN=

# ⚠️ 演示用会员开通开关。设为 1 时 /api/billing/demo-upgrade 允许「不付费直接升会员」，
# 只用于内测/给人演示会员权益。正式对外环境务必留空 —— 否则等于开了白嫖后门。
# 留空时支付页会如实提示「支付通道尚未接入」。
ALLOW_DEMO_UPGRADE=

# 视频爆款分析（/analyze）提供商：mock（默认）| openai | deepseek | claude | qwen
#   - qwen  → 千问（感知/内容理解层），需 QWEN_API_KEY
#   - deepseek → 推理层，需 DEEPSEEK_API_KEY
AI_PROVIDER=mock

# 千问 / Qwen（阿里 DashScope，兼容 OpenAI 接口）
#   文本模型默认 qwen-plus；带图/视频理解自动切 qwen-vl-max-latest
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_VL_MODEL=qwen-vl-max

# DeepSeek（推理/生成层：写文案、热点润色、分类）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 通用兜底 Key（未单独设置上面某个 Key 时，可用它同时驱动两个 provider）
LLM_API_KEY=

# OpenAI（可选）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Claude（可选）
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ── 站点与邮件（邮箱验证 / 找回密码）────────────────────────────────
# 站点对外根地址（用于邮件里的链接；生产必须配置，如 https://viralstudio.ai）
SITE_URL=http://localhost:3000

# 邮件服务：配置 RESEND_API_KEY 后真实发信；不配置则在开发模式打印到日志并返回 devLink
RESEND_API_KEY=
# 发件地址（Resend 测试可用 onboarding@resend.dev；正式请绑自己的域名）
EMAIL_FROM=爆款研究所 <onboarding@resend.dev>

# ── 真实视频理解（上传分析）──────────────────────────────────────────
# 设为 1 时视觉理解走演示摘要（不调用视觉模型、不烧额度）；留空且配置 QWEN_API_KEY 时为真实 Qwen-VL
AI_VISION_MOCK=1

# ── 服务器化视频上传与理解（Vercel 部署必读）────────────────────────
# Vercel Blob 读写令牌（https://vercel.com/docs/storage/vercel-blob）。
# 配置后：前端把视频直传到 Blob 对象存储（绕开 Serverless 函数 4.5MB 请求体限制），
# 服务端拿公网 URL 直接交给 Qwen-VL 看视频（无需 ffmpeg、无需本地文件）。
# 未配置时回退「本机 /api/analyze/upload + ffmpeg 抽帧」（仅开发用）。
BLOB_READ_WRITE_TOKEN=

# 语音转写（ASR）：设为 1 时用 Qwen-Audio（qwen-audio-turbo）对视频 URL 转写语音
AI_ASR=1
# 转写模型（Qwen-Omni 支持视频/音频 URL 直转写；备选 qwen-audio-turbo 仅音频）
QWEN_AUDIO_MODEL=qwen-omni-turbo

# ── AI 接口防刷（可选，有默认值）────────────────────────────────────
# 单 IP 每小时调用次数上限。SCOPE 取值：ANALYZE / COPY / REPLICATE / HOTSPOTS / PLAN / RENDER
# 默认：ANALYZE=10、COPY=30、REPLICATE=10、HOTSPOTS=30、PLAN=20、RENDER=5
# 例：AI_LIMIT_ANALYZE=20
AI_LIMIT_ANALYZE=
AI_LIMIT_COPY=
AI_LIMIT_REPLICATE=
AI_LIMIT_HOTSPOTS=

# 连续触发限流多少次后自动封禁该 IP（默认 3）
AI_BAN_THRESHOLD=3
# 自动封禁时长（毫秒，默认 24 小时 = 86400000）
AI_BAN_MS=86400000

# IP 封禁管理接口口令（/api/admin/ip 的 Bearer Token）。
# 不配置则管理接口不可用；配置后可用 scripts/ip-admin.mjs 查/封/解封。
ADMIN_TOKEN=

# ── 免费公测阶段（会员上线前保持默认）────────────────────────────────
# 设为 0 时恢复「完整报告需会员」的门禁；会员正式收费后设置。
NEXT_PUBLIC_FREE_FULL_ACCESS=1

# ── 服务端配额（会员功能基础，免费公测期已生效）────────────────────
# 按会员档位的每日分析次数（设 0 表示不限次）
DAILY_ANALYZE_FREE=1
DAILY_ANALYZE_CREATOR=5
# 匿名用户每 IP 每天可分析次数（默认 3，防止白嫖 AI 额度）
ANON_DAILY_ANALYZE=3

# ── Phase 15-B：多角色知识底座 / 每日学习任务（后台，低优先级）──────
# 每日学习任务与用户生成任务完全隔离：学习任务绝不消耗用户 quota。
# 每日可执行的学习任务次数（默认 1）
LEARNING_DAILY_LIMIT=1
# 每次学习任务最多允许的 AI 调用次数（默认 20；0 表示不限）
LEARNING_MAX_AI_CALLS=20
# 每次学习任务最多处理的候选样本数（默认 10）
LEARNING_MAX_ITEMS=10
# 管理接口口令：调 /api/director-learning/run 与 /report 需带此 token
ADMIN_TOKEN=
