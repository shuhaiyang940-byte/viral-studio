# ── 爆款研究所 · 环境变量 ─────────────────────────────────────────────
# 复制为 .env.local 后填值。所有 Key 仅服务端使用，切勿暴露到前端。
# 不填任何 Key 也能跑（全走 mock / 本地模板 / 启发式），只是没有真模型能力。

# ── 账号体系（必填，否则注册/登录会返回 503）────────────────────────
# Postgres 连接串。推荐 Neon（neon.tech）免费档，格式：
#   postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# 会话 JWT 签名密钥。生成一个随机长串，别用弱口令：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ⚠️ 改这个值会让所有已登录用户被登出。
JWT_SECRET=

# 种子数据导入口令（保护 /api/seed，不设置则该接口直接拒绝执行）
#   上线后执行一次：curl "https://你的域名/api/seed?token=<这里的值>"
SEED_TOKEN=

# ⚠️ 演示用会员开通开关。设为 1 时 /api/billing/demo-upgrade 允许「不付费直接升会员」，
# 只用于内测/给人演示会员权益。正式对外环境务必留空 —— 否则等于开了白嫖后门。
# 留空时支付页会如实提示「支付通道尚未接入」。
ALLOW_DEMO_UPGRADE=

# 视频爆款分析（/analyze）提供商：mock（默认）| openai | deepseek | claude | qwen
#   - qwen  → 千问（感知/内容理解层），需 QWEN_API_KEY
#   - deepseek → 推理层，需 DEEPSEEK_API_KEY
AI_PROVIDER=mock

# 千问 / Qwen（阿里 DashScope，兼容 OpenAI 接口）
#   文本模型默认 qwen-plus；带图/视频理解自动切 qwen-vl-max-latest
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_VL_MODEL=qwen-vl-max-latest

# DeepSeek（推理/生成层：写文案、热点润色、分类）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 通用兜底 Key（未单独设置上面某个 Key 时，可用它同时驱动两个 provider）
LLM_API_KEY=

# OpenAI（可选）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Claude（可选）
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
